{{!Stat bar segment for character sheet header}}
<div class="abilities grid grid-5col">
    {{#each system.abilities as |ability key|}}
        <div class="ability flexrow flex-group-center">
            {{#with (lookup @root.config.abilities key)}}
            <label
                class="resource-label rollable align-center"
                data-action="roll"
                data-roll="d10+@abilities.{{key}}.mod"
                data-label="{{localize label}}"
            >{{localize label}}</label>
            {{/with}}
            <input
                type='text'
                name='system.abilities.{{key}}.value'
                value='{{ability.value}}'
                class="ability-score"
                data-dtype='Number'
            />
            <input
                type='text'
                class='species-ability-bonus tiny-mod-box'
                value='{{numberFormat ability.speciesBonus decimals=0 sign=true}}'
                title='{{localize "MOFAN.Actor.HealthSpeciesBonus"}}'
                disabled
                tabindex='-1'
            />
        </div>
    {{/each}}
</div>
