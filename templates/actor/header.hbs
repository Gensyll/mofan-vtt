{{! Sheet Header }}
<header class='sheet-header'>
  <img
    class='profile-img'
    src='{{actor.img}}'
    data-edit='img'
    data-action='onEditImage'
    title='{{actor.name}}'
    height='100'
    width='100'
  />
  <div class='header-fields'>
    <div class='document-name-row'>
      <div class='document-name'>
        <input
          name='name'
          type='text'
          value='{{actor.name}}'
          placeholder='Name'
        />
      </div>
      <div class='document-species species-drop'>
        {{#if ownedSpecies}}
          <div
            class='species-drop-filled flexrow'
            data-item-id='{{ownedSpecies._id}}'
            data-document-class='Item'
          >
            <a data-action='viewDoc' title='{{ownedSpecies.name}}'>
              {{ownedSpecies.name}}
            </a>
            {{#if ownedSpecies.sizeLabel}}
              <span class='species-sep' aria-hidden='true'>|</span>
              <span class='species-size hint'>{{ownedSpecies.sizeLabel}}</span>
            {{/if}}
            {{#if @root.editable}}
              <a
                class='item-control'
                data-action='clearSpecies'
                title='{{localize "MOFAN.Actor.SpeciesClear"}}'
              >
                <i class='fas fa-times'></i>
              </a>
            {{/if}}
          </div>
        {{else}}
          <span class='hint species-drop-empty'>
            {{localize 'MOFAN.Actor.SpeciesDrop'}}
          </span>
        {{/if}}
      </div>
    </div>
    <div class='resources header-resources grid grid-2col'>
      <div class='resource health-resource flex-group-center'>
        <div class='resource-content health-pair flexrow flex-center'>
          <div class='health-field'>
            <label class='resource-label' for='system.health.value'>
              {{localize 'MOFAN.Actor.HealthCurrent'}}
            </label>
            <input
              class='resource-value health-value'
              type='text'
              name='system.health.value'
              value='{{system.health.value}}'
              data-dtype='Number'
            />
          </div>
          <div class='health-field'>
            <label class='resource-label'>
              {{localize 'MOFAN.Actor.HealthMax'}}
            </label>
            <input
              class='resource-value health-eff-max'
              type='text'
              value='{{system.health.max}}'
              disabled
            />
          </div>
        </div>
        <div class='health-breakdown flexrow flex-center'>
          <span class='health-breakdown-label'>{{localize 'MOFAN.Actor.HealthSpeciesBonus'}}</span>
          <input
            type='text'
            class='tiny-mod-box'
            value='{{numberFormat healthSpeciesBonus decimals=0 sign=true}}'
            disabled
            tabindex='-1'
          />
          <span class='health-breakdown-label'>{{localize 'MOFAN.Actor.HealthFortitude'}}</span>
          <input
            type='text'
            class='tiny-mod-box'
            value='{{numberFormat healthFortitude decimals=0 sign=true}}'
            disabled
            tabindex='-1'
          />
          <span class='health-breakdown-label'>{{localize 'MOFAN.Actor.HealthDisciplineBonusAbbr'}}</span>
          <input
            type='text'
            class='tiny-mod-box'
            value='{{numberFormat healthDisciplineBonus decimals=0 sign=true}}'
            disabled
            tabindex='-1'
          />
        </div>
      </div>

      <div class='header-resources-right grid grid-2col'>
        <div class='resource flex-group-center'>
          <label for='system.power.value' class='resource-label'>
            {{localize 'MOFAN.Actor.base.FIELDS.power.value.label'}}
          </label>
          <div class='resource-content resource-pair flexrow flex-center'>
            <input
              class='resource-value'
              type='text'
              name='system.power.value'
              value='{{system.power.value}}'
              data-dtype='Number'
            />
            <span>/</span>
            <input
              class='resource-value'
              type='text'
              name='system.power.max'
              value='{{system.power.max}}'
              data-dtype='Number'
            />
          </div>
        </div>

        <div class='resource flex-group-center'>
          {{#if (eq actor.type 'character')}}
            <label class='resource-label'>
              {{localize 'MOFAN.Actor.Character.FIELDS.attributes.level.value.label'}}
            </label>
            <div class='resource-content resource-single flexrow flex-center'>
              <input
                class='resource-value level-input'
                type='text'
                name='system.attributes.level.value'
                value='{{system.attributes.level.value}}'
                data-dtype='Number'
              />
            </div>
          {{/if}}
          {{#if (eq actor.type 'npc')}}
            <label class='resource-label'>
              {{localize 'MOFAN.Actor.NPC.FIELDS.cr.label'}} / {{localize 'MOFAN.Actor.NPC.xp.label'}}
            </label>
            <div class='resource-content resource-pair flexrow flex-center'>
              <input
                class='resource-value'
                type='text'
                name='system.cr'
                value='{{system.cr}}'
                data-dtype='Number'
              />
              <span>/</span>
              <input
                class='resource-value'
                type='text'
                disabled='true'
                name='system.xp'
                value='{{system.xp}}'
                data-dtype='Number'
              />
            </div>
          {{/if}}
        </div>
      </div>
    </div>
    {{> "mofan-vtt.actor-stat-bar"}}
  </div>
</header>
