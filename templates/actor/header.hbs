{{! Sheet Header }}
<header class='sheet-header'>
  <img
    class='profile-img'
    src='{{actor.img}}'
    data-edit='img'
    data-action='onEditImage'
    title='{{actor.name}}'
    height='100'
    width='100'
  />
  <div class='header-fields'>
    <div class='document-name-row'>
      <div class='document-name'>
        <input
          name='name'
          type='text'
          value='{{actor.name}}'
          placeholder='Name'
        />
      </div>
      <div class='document-species'>
        <input
          name='system.species'
          type='text'
          value='{{system.species}}'
          placeholder='{{localize "MOFAN.Actor.base.FIELDS.species.label"}}'
        />
      </div>
    </div>
    <div class='resources header-resources grid grid-2col'>
      <div class='resource health-resource flex-group-center'>
        <div class='resource-content health-triple flexrow flex-center'>
          <div class='health-field'>
            <label class='resource-label' for='system.health.value'>
              {{localize 'MOFAN.Actor.HealthCurrent'}}
            </label>
            <input
              class='resource-value health-value'
              type='text'
              name='system.health.value'
              value='{{system.health.value}}'
              data-dtype='Number'
            />
          </div>
          <div class='health-field'>
            <label
              class='resource-label'
              title='{{localize "MOFAN.Actor.HealthEffectiveMax"}}'
            >
              {{localize 'MOFAN.Actor.HealthMax'}}
            </label>
            <span class='resource-value health-eff-max'>
              {{system.health.max}}
            </span>
          </div>
          <div class='health-field'>
            <label
              class='resource-label'
              for='system.health.max'
              title='{{localize "MOFAN.Actor.base.FIELDS.health.max.label"}}'
            >
              {{localize 'MOFAN.Actor.HealthBase'}}
            </label>
            <input
              class='resource-value health-base-max'
              type='text'
              name='system.health.max'
              value='{{healthMaxBase}}'
              data-dtype='Number'
            />
          </div>
        </div>
        <div class='health-discipline-bonus hint'>
          {{localize 'MOFAN.Actor.HealthDisciplineBonus'}}: +{{healthDisciplineBonus}}
        </div>
      </div>

      <div class='header-resources-right grid grid-2col'>
        <div class='resource flex-group-center'>
          <label for='system.power.value' class='resource-label'>
            {{localize 'MOFAN.Actor.base.FIELDS.power.value.label'}}
          </label>
          <div class='resource-content resource-pair flexrow flex-center'>
            <input
              class='resource-value'
              type='text'
              name='system.power.value'
              value='{{system.power.value}}'
              data-dtype='Number'
            />
            <span>/</span>
            <input
              class='resource-value'
              type='text'
              name='system.power.max'
              value='{{system.power.max}}'
              data-dtype='Number'
            />
          </div>
        </div>

        <div class='resource flex-group-center'>
          {{#if (eq actor.type 'character')}}
            <label class='resource-label'>
              {{localize 'MOFAN.Actor.Character.FIELDS.attributes.level.value.label'}}
            </label>
            <div class='resource-content resource-single flexrow flex-center'>
              <input
                class='resource-value level-input'
                type='text'
                name='system.attributes.level.value'
                value='{{system.attributes.level.value}}'
                data-dtype='Number'
              />
            </div>
          {{/if}}
          {{#if (eq actor.type 'npc')}}
            <label class='resource-label'>
              {{localize 'MOFAN.Actor.NPC.FIELDS.cr.label'}} / {{localize 'MOFAN.Actor.NPC.xp.label'}}
            </label>
            <div class='resource-content resource-pair flexrow flex-center'>
              <input
                class='resource-value'
                type='text'
                name='system.cr'
                value='{{system.cr}}'
                data-dtype='Number'
              />
              <span>/</span>
              <input
                class='resource-value'
                type='text'
                disabled='true'
                name='system.xp'
                value='{{system.xp}}'
                data-dtype='Number'
              />
            </div>
          {{/if}}
        </div>
      </div>
    </div>
    {{> "mofan-vtt.actor-stat-bar"}}
  </div>
</header>
