<div class='mofan-weapon-card'>
  {{#if hasDetails}}
  <details>
    <summary class='card-header'>
      <img src='{{item.img}}' alt='{{item.name}}' width='36' height='36' />
      <div class='card-title'>
        <strong>{{item.name}}</strong>
        <div class='hint'>
          {{categoryLabel}}{{#if range}} · {{range}}{{localize 'MOFAN.Item.Weapon.RangeUnit'}}{{/if}}{{#if damageDie}} · {{damageDie}}{{/if}}
        </div>
      </div>
      <span class='card-expand-hint'>
        <span class='when-closed'>{{localize 'MOFAN.Weapon.ShowMore'}}</span>
        <span class='when-open'>{{localize 'MOFAN.Weapon.ShowLess'}}</span>
      </span>
    </summary>
    <div class='card-details'>
      {{#if description}}
        <div class='card-description'>{{{description}}}</div>
      {{/if}}
      {{#if properties.length}}
        <ul class='card-properties'>
          {{#each properties as |prop|}}
            <li>
              <strong>{{prop.label}}</strong>
              <div class='hint'>{{prop.description}}</div>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    </div>
  </details>
  {{else}}
  <div class='card-header'>
    <img src='{{item.img}}' alt='{{item.name}}' width='36' height='36' />
    <div class='card-title'>
      <strong>{{item.name}}</strong>
      <div class='hint'>
        {{categoryLabel}}{{#if range}} · {{range}}{{localize 'MOFAN.Item.Weapon.RangeUnit'}}{{/if}}{{#if damageDie}} · {{damageDie}}{{/if}}
      </div>
    </div>
  </div>
  {{/if}}
  <div class='card-buttons'>
    <button
      type='button'
      data-mofan-weapon-action='weaponAttack'
      data-uuid='{{item.uuid}}'
    >
      {{localize 'MOFAN.Weapon.Attack'}}
    </button>
    <button
      type='button'
      data-mofan-weapon-action='weaponDamage'
      data-uuid='{{item.uuid}}'
    >
      {{localize 'MOFAN.Weapon.Damage'}}
    </button>
  </div>
</div>
